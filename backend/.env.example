PORT=5000
JWT_SECRET=your-strong-secret-key-here
NODE_ENV=production
FRONTEND_URL=https://link-lecture-1.onrender.com
# LL Assistant AI provider (optional). If missing/invalid/rate-limited/down,
# the chatbot automatically falls back to offline rule-based responses —
# the app works fine with this left blank.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
